{
  "version": "0.1.0",
  "name": "@fcrozatier/auto-env",
  "license": "MIT",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true
  },
  "tasks": {
    "check:all": "deno fmt --check && deno lint && deno check && deno test -A && deno test -A --doc && deno doc --lint main.ts",
    "gen:env": "deno watch --watch-hmr=.env -A scripts/auto-env.ts",
    "dev": {
      "command": "deno watch -A start.ts",
      "dependencies": ["gen:env"]
    }
  },
  "exports": {
    ".": "./main.ts"
  },
  "imports": {
    "$/": "./",

    "@fcrozatier/monarch": "jsr:@fcrozatier/monarch@^3.2.1",
    "@standard-schema/spec": "jsr:@standard-schema/spec@^1.1.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/path": "jsr:@std/path@^1.1.6",

    "valibot": "jsr:@valibot/valibot@^1.4.2"
  },
  "fmt": {
    "exclude": [".env*"]
  },
  "publish": {
    "exclude": [
      ".github",
      ".vscode",
      "assets",
      ".env*",
      "scripts",
      "start.ts",
      "tests"
    ]
  }
}
