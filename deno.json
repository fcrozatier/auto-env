{
  "version": "0.1.0",
  "name": "@fcrozatier/auto-env",
  "license": "MIT",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true
  },
  "tasks": {
    "check:all": "deno fmt --check && deno lint && deno check && deno test -A && deno test -A --doc && deno doc --lint src/main.ts",
    "gen:docs": "deno doc --html src/main.ts && open docs/index.html",
    "gen:env": "deno watch --watch-hmr=e2e/.env -A e2e/auto-env.ts",
    "test:e2e": {
      "command": "deno watch -A e2e/start.ts",
      "dependencies": ["gen:env"]
    },
    "test:coverage": "deno test -A --coverage && open coverage/html/index.html"
  },
  "exports": {
    ".": "./src/main.ts"
  },
  "imports": {
    "$/": "./",

    "@fcrozatier/monarch": "jsr:@fcrozatier/monarch@^3.2.1",
    "@standard-schema/spec": "jsr:@standard-schema/spec@^1.1.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/path": "jsr:@std/path@^1.1.6",

    "valibot": "jsr:@valibot/valibot@^1.4.2"
  },
  "fmt": {
    "exclude": [".env*"]
  },
  "publish": {
    "exclude": [
      ".github",
      ".vscode",
      "assets",
      "e2e",
      "tests"
    ]
  }
}
