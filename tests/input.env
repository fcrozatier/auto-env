# Handles booleans by default
DEV=true
# Distinguishes boolean strings
DEV_STRING="true"

# Handles numbers by default
PORT=3000
# Distinguishes number strings
PORT_STRING="3000"

# Double-quoted value with spaces and escape sequences
GREETING="Hello, World!"
MULTILINE="first line\nsecond line"

# Single-quoted literal value — no interpolation
REGEX="\d{3}-\d{4}"

# Empty values
OPTIONAL_FLAG=
ALSO_EMPTY=""

# Multiline value with real newlines
PRIVATE_KEY="
-----BEGIN EC KEY-----
MHQCAQEEIBkg...
-----END EC KEY-----"